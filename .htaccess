# ========================================================
# BuildORA Production & Hosting Configuration (.htaccess)
# ========================================================

# 1. Set Default Index Page
DirectoryIndex index.php index.html

# 2. Protect Sensitive Files & Database Dumps
<IfModule mod_authz_core.c>
    <FilesMatch "\.(sql|env|log|tmp|json|lock|git)$">
        Require all denied
    </FilesMatch>
    <FilesMatch "^(database\.local\.php|database\.example\.php|\.htaccess|\.gitignore)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(sql|env|log|tmp|json|lock|git)$">
        Order Allow,Deny
        Deny from all
    </FilesMatch>
    <FilesMatch "^(database\.local\.php|database\.example\.php|\.htaccess|\.gitignore)$">
        Order Allow,Deny
        Deny from all
    </FilesMatch>
</IfModule>

# 3. Default Charset & Security Headers
AddDefaultCharset UTF-8
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
