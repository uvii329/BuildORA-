# Secure uploads directory - prevent script execution
<IfModule mod_authz_core.c>
    <FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|cgi|pl|py|jsp|asp|htm|html|sh|bat)$">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    <FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|cgi|pl|py|jsp|asp|htm|html|sh|bat)$">
        Order Allow,Deny
        Deny from all
    </FilesMatch>
</IfModule>
